# Voice Bridge Configuration
# Copy to config.env, fill in paths, then: source config.env && ./voice-bridge

# Piper TTS binary and voice model
PIPER_BIN=$HOME/.local/bin/piper
PIPER_MODEL=$HOME/.local/share/piper/en_GB-alan-medium.onnx

# OpenClaw binary and session to route voice queries to
OPENCLAW_BIN=$HOME/.npm-global/bin/openclaw
OPENCLAW_SESSION=agent:main:telegram:direct:<YOUR_CHAT_ID>

# Server listen address
LISTEN_ADDR=127.0.0.1:5001

# Whisper model size: tiny, base, small, medium
WHISPER_MODEL=tiny
